# DORMANT — intentionally outside .github/workflows.
# Requires confirmed owner-selected repo, audited action SHA pins and review.
# Tests only. No package registry, download URL, signing or release upload.
name: Native companion source checks
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  native-test:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        working-directory: cli
    steps:
      # Before activation replace these tokens with audited full SHA digests.
      - uses: actions/checkout@REQUIRES_AUDITED_FULL_COMMIT_SHA
        with:
          persist-credentials: false
      - uses: actions/setup-go@REQUIRES_AUDITED_FULL_COMMIT_SHA
        with:
          go-version: '1.25.7'
          cache: false
      - run: go test -count=1 ./...
      - run: go vet ./...
      - run: go build -trimpath -buildvcs=false ./cmd/evolution
# Native running-copy uninstall, ACL, popular-shell, arm64 host and signing
# trust tests must be added/verified before ANY distribution job is designed.